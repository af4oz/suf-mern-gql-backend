# Ignore `PORT` if you're running on CI/Codesanbox/Stackblitz(issue with assigning ports) 
PORT=

JWT_SECRET=<long_random_string>

# If following Readme.md instructions(Local setup/Codesanbox Setup 👇)
# MONGODB_URI=mongodb://mongo:27017/
# OR else 👇
MONGODB_URI=mongodb://<username>:<password>@<mongodb_service_identifier>:27017/

