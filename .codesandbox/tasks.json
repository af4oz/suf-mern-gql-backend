{
  "$schema": "https://codesandbox.io/schemas/tasks.json",
  "setupTasks": [
    // "yarn install",
    // "yarn server build",
    // "yarn server start:mongo",
    // "yarn server start:dev"
  ],
  "tasks": {
    "install": {
      "name": "Install Dependencies",
      "command": "yarn install"
    },
    "build": {
      "name": "Build App",
      "command": "yarn server build"
    },
    "start:mongo": {
      "name": "Start MongoDB",
      "command": "yarn server start:mongo"
    },
    "kill:mongo": {
      "name": "Kill MongoDB Process",
      "command": "yarn server kill:mongo"
    },
    "start:dev": {
      "name": "Start Development Server",
      "command": "yarn server start:dev"
    }
  }
}
